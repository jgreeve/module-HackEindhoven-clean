{
  "name": "tablette",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "tablette — OSM + Leaflet generative app.",
  "license": "MIT",
  "scripts": {
    "predev": "npm run sync:bimr && npm run gen:modules",
    "dev": "vite",
    "prebuild": "npm run sync:bimr && npm run gen:modules",
    "build": "vite build",
    "preview": "vite preview",
    "proxy": "node proxy/node.mjs",
    "gen:modules": "node scripts/gen-registry.mjs",
    "pretypecheck": "npm run gen:modules",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run test:smoke --prefix=../..",
    "test:proxy": "node --test proxy/proxy.test.mjs",
    "test:modules": "node ../../scripts/modules.mjs test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sync:bimr": "node scripts/sync-bimr.mjs"
  },
  "dependencies": {
    "@hackeindhoven/module-contracts": "0.1.0",
    "@ai-sdk/openai": "^2.0.125",
    "@ai-sdk/react": "^2.0.256",
    "@bimr/web": "^0.0.2",
    "@codemirror/lang-html": "^6.4.12",
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "@tablette/module-canutes": "^0.1.0",
    "@tablette/module-eindhoven": "0.1.0",
    "@tablette/module-opendata": "^0.1.0",
    "@tablette/module-report": "^0.1.0",
    "@tablette/module-sdk": "^0.1.0",
    "@tablette/module-wikidata": "^0.1.0",
    "@tablette/module-wikimedia": "^0.1.0",
    "ai": "^5.0.253",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "isomorphic-git": "^1.42.0",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4"
  }
}
